<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/app_bg"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageView
            android:id="@+id/ivShopLogo"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:contentDescription="PrintEase logo"
            android:src="@drawable/ic_printease_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvShopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Register Your Shop"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_25ssp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/ivShopLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvShopSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Join PrintEase as a printing partner"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_13ssp"
            app:layout_constraintTop_toBottomOf="@id/tvShopTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvOwnerNameLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:text="Owner Name"
            android:textColor="@color/primary_text"
            android:textStyle="bold"
            android:textSize="@dimen/_13ssp"
            app:layout_constraintTop_toBottomOf="@id/tvShopSubtitle" />

        <EditText
            android:id="@+id/etOwnerName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Enter owner name"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:singleLine="true"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintTop_toBottomOf="@id/tvOwnerNameLabel" />

        <TextView
            android:id="@+id/tvShopNameLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Shop Name"
            android:textColor="@color/primary_text"
            android:textStyle="bold"
            android:textSize="@dimen/_13ssp"
            app:layout_constraintTop_toBottomOf="@id/etOwnerName" />

        <EditText
            android:id="@+id/etShopName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Enter printing shop name"
            android:inputType="textCapWords"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:singleLine="true"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintTop_toBottomOf="@id/tvShopNameLabel" />

        <TextView
            android:id="@+id/tvShopEmailLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Email Address"
            android:textColor="@color/primary_text"
            android:textStyle="bold"
            android:textSize="@dimen/_13ssp"
            app:layout_constraintTop_toBottomOf="@id/etShopName" />

        <EditText
            android:id="@+id/etShopEmail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Enter email address"
            android:inputType="textEmailAddress"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:singleLine="true"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintTop_toBottomOf="@id/tvShopEmailLabel" />

        <TextView
            android:id="@+id/tvShopPhoneLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mobile Number"
            android:textColor="@color/primary_text"
            android:textStyle="bold"
            android:textSize="@dimen/_13ssp"
            app:layout_constraintTop_toBottomOf="@id/etShopEmail" />

        <EditText
            android:id="@+id/etShopPhone"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Enter 10-digit mobile number"
            android:inputType="phone"
            android:maxLength="10"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:singleLine="true"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintTop_toBottomOf="@id/tvShopPhoneLabel" />

        <TextView
            android:id="@+id/tvShopAddressLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Shop Address"
            android:textColor="@color/primary_text"
            android:textStyle="bold"
            android:textSize="@dimen/_13ssp"
            app:layout_constraintTop_toBottomOf="@id/etShopPhone" />

        <EditText
            android:id="@+id/etShopAddress"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:hint="Enter complete shop address"
            android:inputType="textPostalAddress|textMultiLine"
            android:padding="15dp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintTop_toBottomOf="@id/tvShopAddressLabel" />

        <TextView
            android:id="@+id/tvShopPasswordLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Password"
            android:textColor="@color/primary_text"
            android:textStyle="bold"
            android:textSize="@dimen/_13ssp"
            app:layout_constraintTop_toBottomOf="@id/etShopAddress" />

        <EditText
            android:id="@+id/etShopPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Create password"
            android:inputType="textPassword"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:singleLine="true"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintTop_toBottomOf="@id/tvShopPasswordLabel" />

        <TextView
            android:id="@+id/tvShopConfirmLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Confirm Password"
            android:textColor="@color/primary_text"
            android:textStyle="bold"
            android:textSize="@dimen/_13ssp"
            app:layout_constraintTop_toBottomOf="@id/etShopPassword" />

        <EditText
            android:id="@+id/etShopConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Confirm your password"
            android:inputType="textPassword"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:singleLine="true"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintTop_toBottomOf="@id/tvShopConfirmLabel" />

        <Button
            android:id="@+id/btnRegisterShop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_button"
            app:backgroundTint="@null"
            android:text="Register Shop"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/etShopConfirmPassword" />

        <TextView
            android:id="@+id/tvShopLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="8dp"
            android:text="Already registered? Login"
            android:textColor="@color/accent_color"
            android:textSize="@dimen/_13ssp"
            app:layout_constraintTop_toBottomOf="@id/btnRegisterShop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
